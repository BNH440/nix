+    registerOverridePrototype(WindowManager.WindowManager, 'handleWorkspaceScroll',
+        function (event) {
+            if (event.type() !== Clutter.EventType.SCROLL)
+                return Clutter.EVENT_PROPAGATE;
+
+            const direction = event.get_scroll_direction();
+
+            if (direction === Clutter.ScrollDirection.UP || direction === Clutter.ScrollDirection.DOWN) {
+                const time = Date.now();
+                if (this._paperwm_last_scroll && (time - this._paperwm_last_scroll) < 150) {
+                    return Clutter.EVENT_STOP;
+                }
+                this._paperwm_last_scroll = time;
+
+                const tabPopup = Navigator.getActionDispatcher();
+                const action = direction === Clutter.ScrollDirection.UP ? 'switch-global-right' : 'switch-global-left';
+                tabPopup.show(false, action, Clutter.ModifierType.MOD4_MASK);
+                return Clutter.EVENT_STOP;
+            }
+                
+            return Clutter.EVENT_PROPAGATE;
+        });
